# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection used by the API. MUST be the restricted, non-superuser
# application role (crm_app) so Row-Level Security is enforced.
DATABASE_URL=postgresql://crm_app:crm_app_pw@localhost:5432/crm

# Connection used only to run migrations (creates roles, tables, RLS, grants).
# Must be a superuser/owner. For simple local setups this can equal DATABASE_URL
# if that role owns the schema, but using a separate admin role is recommended.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Bcrypt
BCRYPT_SALT_ROUNDS=10
